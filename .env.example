# OpenAI — vision analysis
OPENAI_API_KEY=sk-...
# Cheap vision model; gpt-4o-mini also works
OPENAI_MODEL=gpt-5-mini

# GoHighLevel (LeadConnector) inbound webhooks — one per clinic, fallback optional
GHL_WEBHOOK_LONDON=https://services.leadconnectorhq.com/hooks/.../webhook-trigger/...
GHL_WEBHOOK_GLASGOW=https://services.leadconnectorhq.com/hooks/.../webhook-trigger/...
GHL_WEBHOOK_FALLBACK=

# Public HSMW online consultation calendar (shown to qualified leads)
NEXT_PUBLIC_GHL_CALENDAR_WELLNESS=https://link.harleystreetmedicalwellness.co.uk/widget/bookings/wellness-consultant-1

# Meta Pixel ID for ad attribution
NEXT_PUBLIC_META_PIXEL_ID=

# Vercel Blob (auto-populated when the Blob store is connected on Vercel)
BLOB_READ_WRITE_TOKEN=
